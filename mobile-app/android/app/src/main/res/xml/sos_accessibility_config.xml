<?xml version="1.0" encoding="utf-8"?>
<!--
  Zero UI SOS accessibility service configuration
  ===============================================
  Purpose: observe the configured triple hardware-button press (VOLUME keys,
  see SosAccessibilityService for why the power button is not observable) and
  wake the emergency state machine — nothing else.

  This deliberately sets:
    canRetrieveWindowContent = false   → the service cannot read any screen
                                         content, text, notifications or UI
                                         state. It only receives key events.
    canPerformGestures = false         → cannot tap/swipe/type anything.
    accessibilityFeedback = spoken/visual disabled.
    accessibilityEventTypes = none     → no window/state events are requested.

  An explicit type-announcement + description satisfies Play/enterprise
  accessibility-service disclosure requirements for a narrowly-scoped service.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes=""
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="false"
    android:description="@string/sos_accessibility_description"
    android:summary="@string/sos_accessibility_summary" />
