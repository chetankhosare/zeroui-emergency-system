# ─────────────────────────────────────────────────────────────────────────────
# Zero UI backend configuration
#
# Copy to `.env` (`cp .env.example .env`) — `.env` is gitignored.
# Every ZEROUI_* value has a development default, so the prototype also runs
# with no .env at all. In ZEROUI_ENV=production the three secrets below are
# REQUIRED: the app refuses to start without them (see config.py validation).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ───
ZEROUI_ENV=development                  # development | production
ZEROUI_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ZEROUI_HOST=0.0.0.0                     # use 0.0.0.0 so a phone on the LAN can reach it
ZEROUI_PORT=8000

# ─── Secrets (CHANGE THESE FOR PRODUCTION) ───
ZEROUI_DASHBOARD_TOKEN=zeroui-dev-dashboard-token   # authority sign-in token
ZEROUI_ENROLLMENT_TOKEN=zeroui-dev-enroll-token     # phone enrolment token
ZEROUI_JWT_SECRET=change-me-to-a-long-random-string # signs dashboard sessions
ZEROUI_DASHBOARD_SESSION_MINUTES=720                # dashboard session lifetime

# ─── Storage ───
ZEROUI_DATA_DIR=backend/data            # relative to the repo root if not absolute
ZEROUI_DB_PATH=backend/data/emergencies.db
ZEROUI_AUDIO_DIR=backend/data/audio

# ─── Emergency behaviour ───
ZEROUI_COUNTDOWN_SECONDS=15             # on-device cancel window
ZEROUI_LOCATION_INTERVAL_SECONDS=30     # live location cadence
ZEROUI_AUDIO_SEGMENT_SECONDS=60         # ~1-minute segment upload size
ZEROUI_STALE_AFTER_SECONDS=90           # no update for this long => "stale"

# ─── Limits ───
ZEROUI_MAX_AUDIO_SEGMENT_BYTES=26214400 # 25 MB per segment
ZEROUI_MAX_LIVE_FRAME_BYTES=65536       # 64 KB per live-audio frame

# ─── CORS (dashboard origin) ───
ZEROUI_CORS_ORIGINS=*                   # production: comma-separated explicit origins

# ─── Optional: public dashboard link used in SMS notifications ───
ZEROUI_DASHBOARD_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Optional SMS alerting (Twilio). Leave blank to disable — the backend logs
# "sms skipped" instead of sending, which is the default for local development.
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
